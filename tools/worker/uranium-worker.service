[Unit]
Description=Uranium BC run queue worker (061-R13)
After=network-online.target

[Service]
WorkingDirectory=<repo>
ExecStart=<repo>/target/release/uranium-train worker --queue <shared>/queue/bc.toml --backend rocm --priority 1 --log <repo>/runs/worker.log
KillSignal=SIGINT
KillMode=process
TimeoutStopSec=900
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
