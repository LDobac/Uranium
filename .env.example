# Uranium host settings (spec 001-R9). Copy to `.env` and fill in the values for this host.
# `.env` is git-ignored. Never commit real addresses, host names, accounts or credentials (001-R10).
# Process environment variables override values in this file.
# Use absolute paths: `~` and `$VAR` are not expanded. Put comments on their own line.
# Windows paths go in single quotes (e.g. URANIUM_DATA_DIR='D:\sc_data\openbw'): unquoted `\`
# is an escape character for the Rust loader.
# Credentials (e.g. the SMB password) do not belong here: use a mode-600 cifs credentials file
# on Linux or the Windows credential manager.

# --- Game data (011-R13) ---
# OpenBW data directory produced by tools/casc-extract (e.g. /home/<user>/sc_data/openbw)
URANIUM_DATA_DIR=
# Directory with the target map files fighting_spirit_1.3.scx and circuit_breaker_1.0.scx
URANIUM_MAPS_DIR=

# --- Shared storage (061) ---
# Shared drive root: Linux cifs mount point (e.g. /mnt/<share>),
# Windows local path on the hosting PC (e.g. D:\<share>) or UNC path (\\<server>\<share>)
URANIUM_SHARED_DIR=
# Local cache root on this host (061-R7). Also holds hostd_calibration.toml from
# `uranium-env calibrate` (020-R10).
URANIUM_CACHE_DIR=
# 1 only on the PC that hosts the share itself: read originals without copying (061-R12)
URANIUM_SHARED_LOCAL=0
# Name of this host in run locks (061-R5). Default: the OS host name. Must differ per PC.
# URANIUM_HOST_NAME=

# --- Burn GPU runtime (041-R15) ---
# Fixed local directory for the Burn/CubeCL autotune and kernel cache of this host (not the shared
# drive). Required for GPU training (bc, rl, bc-eval, bc-profile on cuda/vulkan). Keep it for the
# whole run: same host + same cache resumes bit-identically (061-AC1); never delete it mid-run.
# (e.g. /home/<user>/.cache/uranium-autotune or 'D:\uranium\autotune')
URANIUM_AUTOTUNE_CACHE_DIR=

# --- Self-match harness, tools/openbw/selfmatch.sh (optional) ---
# Agent server port
# PORT=7600
# Stop each game after this many frames
# URANIUM_MAX_FRAMES=
# 1 = every game uses seed_base (determinism check)
# SAME_SEED=0

# --- .env location (optional) ---
# Read this file instead of <repo>/.env. Set it in the process environment, not in .env.
# URANIUM_ENV_FILE=

# Internal: URANIUM_AGENT_ADDR, URANIUM_GAME_ID, URANIUM_LAN_SLOT, URANIUM_PRIVILEGED and URANIUM_SEED are passed
# by uranium-hostd (and tools/openbw/selfmatch.sh) to each game launcher. Do not set them here.

# --- uranium-agent debug (optional) ---
# URANIUM_AGENT_DEBUG_VIS=1
# URANIUM_AGENT_DUMP=
# URANIUM_AGENT_DUMP_MAX_FRAME=240

# --- Game host daemon, uranium-hostd (020-R9) ---
# Control listen address (loopback for a single-PC setup)
URANIUM_HOSTD_LISTEN=127.0.0.1:7700
# BWAPI (OpenBW fork) build dir containing bin/BWAPILauncher (e.g. <repo>/third_party/bwapi/build)
URANIUM_BWAPI_DIR=
# Bridge AI module (Linux: liburanium_bridge.so, Windows: uranium_bridge.dll)
URANIUM_BRIDGE_LIB=
# Max concurrent games on this host. Leave empty to use the value measured by
# `uranium-env calibrate` (<URANIUM_CACHE_DIR>/hostd_calibration.toml, 020-R10);
# before calibration the default is max(1, (cores - 1) / 2).
# URANIUM_HOSTD_MAX_GAMES=
# Windows only: first TCP port for OpenBW LAN pairs (011-R16)
# URANIUM_HOSTD_PORT_BASE=17000
# Wall-time limit in seconds for one StartReplay job (040 replay streaming, M4)
# URANIUM_HOSTD_REPLAY_TIMEOUT_S=1800
# Folder for game replays of plans with save_replay = true (040 botgen); default: per-game work dir
# URANIUM_HOSTD_REPLAY_DIR=
# OpenBW drops a LAN client that stops syncing after this many ms (patch 0013, 011-R18).
# hostd passes it to every launcher; lockstep training waits on the agent, so the default is
# 600000 (10 min) instead of OpenBW's 60000.
# URANIUM_OPENBW_DROP_TIMEOUT_MS=600000
# Per-game working directories (default: <system temp>/uranium-hostd)
# URANIUM_HOSTD_WORK_DIR=
# T1 bots built by tools/oss/build_<bot>.sh: <dir>/<bot>/{module.so|module.dll, VERSION, bwapi-data/}
# (default for the build scripts: <repo>/build/oss_bots)
# URANIUM_OSS_BOTS_DIR=

# --- Game scheduler, uranium-env (020) ---
# Host list file (not committed; see config/hosts.example.toml). Default: local hostd only.
# URANIUM_HOSTS_FILE=
# Agent server address the bridges connect to (must be reachable from every game host)
# URANIUM_AGENT_LISTEN=127.0.0.1:7600
# Address handed to bridges when it differs from the listen address (e.g. listen on 0.0.0.0)
# URANIUM_AGENT_PUBLIC_ADDR=
# Inference device for `model` players (020-R11): cuda (CUDA PC, build with --features cuda) | vulkan | flex.
# Default vulkan. `uranium-env run --backend` / `uranium-agent serve --backend` override it.
# URANIUM_AGENT_BACKEND=

# --- features (030 / 031, M5) ---
# Folder of <map_hash>.toml map precomputes written by `uranium-replay build` (031). Required by
# `uranium-replay build` and every BC command (bc, bc-eval, label-check); there is no default
# (B-2): BC refuses to start when a selected game's map has no precompute here.
# Live games also read <map file sha256>.resources.toml from it (`uranium-replay mapgen <scx>`, AMB-031-4).
# Note: the same key also names the hostd map folder above, so on a game host both live in one folder.
# URANIUM_MAPS_DIR=

# --- replay dataset build, uranium-replay (040) ---
# Local folder where `uranium-replay build` completes each shard before copying it to the shared
# drive and verifying the copy by SHA-256 (040-R17). Must be a local disk. A shard whose copy fails
# verification stays here. Default: <temp>/uranium-replay/shard-staging.
# URANIUM_SHARD_STAGING_DIR=

# --- SC:R ladder replay collector, uranium-ladder (043) ---
# Local web API port of the logged-in SC:R client; default: detected from StarCraft.exe (043-R3)
# URANIUM_SCR_API_PORT=
# Requests per second, local API and replay downloads combined (043-R4)
# URANIUM_LADDER_RPS=0.5
# Replay downloads per local calendar day (043-R4)
# URANIUM_LADDER_DAILY_MAX=1000
