# Uranium host settings: copy to `.env` (git-ignored); process environment overrides it.
# Absolute paths only (`~` not expanded); Windows paths in single quotes ('C:\...'), no backslash at the end.
# Outside single quotes `$NAME` / `${NAME}` is replaced silently (empty if unset): keep `$` inside single quotes.
# Outside single quotes: no backslash, no blank inside an unquoted value; such a line stops the load there
# (Rust and Python loaders alike, warning on stderr).
# Comments on their own line. No credentials here (cifs credentials file / credential manager).
# Details: docs/guide/commands.md

# --- Game data ---
# OpenBW data dir from tools/casc-extract (e.g. <repo>/local/sc_data/openbw)
URANIUM_DATA_DIR=
# Folder with fighting_spirit_1.3.scx and circuit_breaker_1.0.scx (also map precomputes, see below)
URANIUM_MAPS_DIR=

# --- Shared storage ---
# Shared drive root: Linux mount (/mnt/<share>), Windows local path (serving host) or UNC
URANIUM_SHARED_DIR=
# Local cache root on this host (also holds hostd_calibration.toml)
URANIUM_CACHE_DIR=
# 1 only on the host that serves the share: read originals without copying
URANIUM_SHARED_LOCAL=0
# Host name in run locks; default OS host name. Must differ per host (case-insensitive)
# URANIUM_HOST_NAME=

# --- Python ---
# venv python with `uranium` + PyTorch, used by worker/supervise to start training; no default
URANIUM_PYTHON=

# --- PyTorch GPU runtime ---
# Linux ROCm host: fixed local folder (not the shared drive) for the MIOpen find-db
# MIOPEN_USER_DB_PATH=

# --- Self-match harness, tools/openbw/selfmatch.sh ---
# Agent server port
# PORT=7600
# Stop each game after this many frames
# URANIUM_MAX_FRAMES=
# 1 = every game uses seed_base (determinism check)
# SAME_SEED=0

# --- .env location ---
# Read this file instead of <repo>/.env; set in the process environment, not in .env
# URANIUM_ENV_FILE=

# Internal, do not set: URANIUM_AGENT_ADDR, URANIUM_GAME_ID, URANIUM_LAN_SLOT, URANIUM_PRIVILEGED,
# URANIUM_SEED, URANIUM_REPLAY_PERSPECTIVE, URANIUM_REPLAY_ENEMY (set by hostd / uranium-replay)

# --- uranium-agent debug ---
# URANIUM_AGENT_DEBUG_VIS=1
# URANIUM_AGENT_DUMP=
# URANIUM_AGENT_DUMP_MAX_FRAME=240

# --- Game host daemon, uranium-hostd ---
# Control listen address (loopback for a single host, LAN address for remote use)
URANIUM_HOSTD_LISTEN=127.0.0.1:7700
# BWAPI (OpenBW fork) build dir with bin/BWAPILauncher (e.g. <repo>/third_party/bwapi/build)
URANIUM_BWAPI_DIR=
# Bridge AI module (Linux liburanium_bridge.so, Windows uranium_bridge.dll)
URANIUM_BRIDGE_LIB=
# Max concurrent games; empty = `uranium-env calibrate` value, else max(1, (cores - 1) / 2)
# URANIUM_HOSTD_MAX_GAMES=
# Windows only: first TCP port for OpenBW LAN pairs
# URANIUM_HOSTD_PORT_BASE=17000
# Wall-time limit in seconds for one StartReplay job
# URANIUM_HOSTD_REPLAY_TIMEOUT_S=1800
# Replay folder for plans with save_replay = true; default per-game work dir
# URANIUM_HOSTD_REPLAY_DIR=
# ms before OpenBW drops a non-syncing LAN client (OpenBW default 60000; lockstep needs long)
# URANIUM_OPENBW_DROP_TIMEOUT_MS=600000
# Per-game work dirs; default <system temp>/uranium-hostd
# URANIUM_HOSTD_WORK_DIR=
# T1 bots from tools/oss/build_<bot>.sh: <dir>/<bot>/...; default <repo>/build/oss_bots
# URANIUM_OSS_BOTS_DIR=

# --- Measurement tools, tools/eval ---
# uranium-replay binary for `cmddump`; default <repo>/target/release/uranium-replay[.exe]
# URANIUM_REPLAY_BIN=

# --- Game scheduler, uranium-env ---
# Host list file (format: config/hosts.example.toml); default local hostd only
# URANIUM_HOSTS_FILE=
# Agent server listen address; must be reachable from every game host
# URANIUM_AGENT_LISTEN=127.0.0.1:7600
# Address given to bridges when it differs from the listen address (e.g. listen on 0.0.0.0)
# URANIUM_AGENT_PUBLIC_ADDR=
# Test only: with plan surrender = "on", the model surrenders at the first decision after this frame
# URANIUM_TEST_SURRENDER_FRAME=2400

# openbw_actions scenario test (process environment only): hostd address, test agent listen address
# URANIUM_TEST_HOSTD=127.0.0.1:7700
# URANIUM_TEST_AGENT_LISTEN=127.0.0.1:0

# --- Features ---
# Map precompute folder (*.toml), required by replay build and BC; same key and folder as above
# URANIUM_MAPS_DIR=

# --- Replay dataset build, uranium-replay ---
# Local disk folder for shards before verified copy to the shared drive; default <temp>/...
# URANIUM_SHARD_STAGING_DIR=
# Debug: print header player -> BWAPI id match and early supply trace
# URANIUM_REPLAY_DEBUG=1

# --- BC training data ---
# Batches prepared ahead (~4 GB each, up to depth + 2 in memory); 0 = no data thread
# URANIUM_BC_PREFETCH=2
# Shard files read and decoded ahead by a reader thread (kept games only); 0 = off (default). CUDA host 2; leave unset on a Linux ROCm host. On: one file being decoded (unfiltered, ~1.7 GiB for a moment) plus the held files stay in memory
# URANIUM_BC_FILE_AHEAD=0
# Entity encoder recompute chunk rows (saves GPU memory, slower); 0 = off
# URANIUM_BC_ENTITY_CHUNK=0
# 1 = keep batch planes zstd-compressed in host memory (~4 GB -> ~1 GB per batch)
# URANIUM_BC_PACK_BATCH=0
# Feed threads; unset or 0 = 3 (more compete with the trainer for CPU)
# URANIUM_BC_FEED_THREADS=
# Lanes per BC lane group (0 = all); unset = config micro_lanes. CUDA host 2, Linux ROCm host 1
# URANIUM_BC_MICRO_LANES=
# Lanes per RL learner lane group (0 = all); unset = config/rl.toml micro_lanes
# URANIUM_RL_MICRO_LANES=
# Linux glibc: mmap blocks of at least this many bytes (returns batch memory to the OS)
# URANIUM_MALLOC_MMAP_THRESHOLD=1048576
# Linux glibc: max malloc arenas (stops memory growth over long BC runs)
# URANIUM_MALLOC_ARENA_MAX=2

# --- Implementation switches (unset = backend default; parentheses: CUDA / Linux ROCm default) ---
# Location head rows: off / exact / mult8 / pow2 (pow2 / exact)
# URANIUM_LOC_ROWS=
# Location head 1x1 output: conv / mulsum (conv / mulsum)
# URANIUM_LOC_OUT=
# Host -> device copies: sync / pinned (BC training pinned, else sync / sync)
# URANIUM_H2D=
# Distance bias gather and table gradient: embedding / index_add / table_t (embedding / table_t)
# URANIUM_BIAS_GRAD=
# Stem and stride-2 conv weight gradients: vendor / bmm (vendor / bmm)
# URANIUM_CONV_WGRAD=
# Entity attention: torch / fused (hand-written kernel) (fused / fused)
# URANIUM_ENTITY_ATTN=
# Linear weight gradients: vendor / splitk (f32 only) (vendor / splitk)
# URANIUM_LINEAR_WGRAD=
# Adam / AdamW update: default / foreach / fused / single (default / default)
# URANIUM_ADAM=
# BC torch.compile: off/default/max-autotune[-no-cudagraphs]/reduce-overhead; needs Triton
# URANIUM_COMPILE=
# Channels-last spatial activations and conv weights: off / on (BC training on, else off / off)
# URANIUM_CHANNELS_LAST=
# Spatial planes rounded to bf16 on the host (bf16 autocast only): off / on (BC training on / off)
# URANIUM_SPATIAL_BF16=
# Stem conv input channels zero-padded to a multiple of 8: off / on (BC training on / off)
# URANIUM_STEM_PAD=
# Compiled shapes: auto / on (symbolic from the start) / off
# URANIUM_COMPILE_DYNAMIC=
# Compiled dropout draws: eager (default) / inductor
# URANIUM_COMPILE_RNG=
# Inference from captured CUDA / HIP graphs: off / on (on / on)
# URANIUM_INFER_GRAPH=
# Largest inference batch replayed from a graph; unset = no limit (Linux ROCm host default 4)
# URANIUM_INFER_GRAPH_MAX_BATCH=
# Inference torch.compile: values as URANIUM_COMPILE (default / off)
# URANIUM_INFER_COMPILE=
# Inference server stream: shared (default) / own; do not use own on Linux ROCm hosts
# URANIUM_INFER_STREAM=
# Profiling JSON lines prefix (<prefix>-<checkpoint>.jsonl, <prefix>-learner.jsonl); unset = off
# URANIUM_INFER_PROFILE=
# Compiled hand-written kernels; default ~/.cache/uranium/kernels
# URANIUM_KERNEL_DIR=

# --- BC training debug ---
# 1 = one JSON line per update on stderr with time per phase
# URANIUM_BC_PROFILE=1

# --- Tests ---
# Burn parity dump folders, os.pathsep separated
# URANIUM_PARITY_DIRS=
# Real BC shards for the Rust / Python batch comparison test
# URANIUM_TEST_SHARDS=

# --- Windows OpenBW build ---
# CMake generator; default "Visual Studio 18 2026" (older: "Visual Studio 17 2022")
# URANIUM_CMAKE_GENERATOR=

# --- SC:R bridge, tools/scr ---
# samase64.exe (samase 0.10.28-64; run.ps1 checks its SHA-256)
# URANIUM_SCR_SAMASE=
# samase mod folder for the bridge DLL; default <repo>\runs\scr\mod
# URANIUM_SCR_MOD_DIR=
# Agent server of `python -m uranium scr`; default 127.0.0.1:7700
# URANIUM_SCR_AGENT_ADDR=
# Bridge log folder; default <repo>\runs\scr\logs
# URANIUM_SCR_LOG_DIR=
# Debug: write the GameInfo message to this file at game start
# URANIUM_SCR_DUMP_GAMEINFO=

# --- SC:R ladder replay collector, uranium-ladder ---
# Local web API port of the logged-in SC:R client; default detected from StarCraft.exe
# URANIUM_SCR_API_PORT=
# Requests per second, local API and replay downloads combined
# URANIUM_LADDER_RPS=0.5
# Replay downloads per local calendar day
# URANIUM_LADDER_DAILY_MAX=1000
