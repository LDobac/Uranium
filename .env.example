# Uranium host settings (spec 001-R9). Copy to `.env` and fill in the values for this host.
# `.env` is git-ignored. Never commit real addresses, host names, accounts or credentials (001-R10).
# Process environment variables override values in this file.
# Use absolute paths: `~` and `$VAR` are not expanded. Put comments on their own line.
# Windows paths go in single quotes (e.g. URANIUM_DATA_DIR='D:\sc_data\openbw'): unquoted `\`
# is an escape character for the Rust loader.
# Credentials (e.g. the SMB password) do not belong here: use a mode-600 cifs credentials file
# on Linux or the Windows credential manager.

# --- Game data (011-R13) ---
# OpenBW data directory produced by tools/casc-extract (e.g. /home/<user>/sc_data/openbw)
URANIUM_DATA_DIR=
# Directory with the target map files fighting_spirit_1.3.scx and circuit_breaker_1.0.scx
URANIUM_MAPS_DIR=

# --- Shared storage (061) ---
# Shared drive root: Linux cifs mount point (e.g. /mnt/<share>),
# Windows local path on the host that serves the share (e.g. D:\<share>) or UNC path (\\<server>\<share>)
URANIUM_SHARED_DIR=
# Local cache root on this host (061-R7). Also holds hostd_calibration.toml from
# `uranium-env calibrate` (020-R10).
URANIUM_CACHE_DIR=
# 1 only on the host that serves the share itself: read originals without copying (061-R12)
URANIUM_SHARED_LOCAL=0
# Name of this host in run locks (061-R5). Default: the OS host name. Must differ per host.
# URANIUM_HOST_NAME=

# --- Python training and inference (001-R9, AMB-000-4) ---
# Interpreter of the venv with the `uranium` package and PyTorch: the run queue worker and
# `uranium-train supervise` start their training children as `<URANIUM_PYTHON> -m uranium ...`.
# No default (e.g. /home/<user>/Uranium/.venv/bin/python or 'C:\Uranium\.venv\Scripts\python.exe').
URANIUM_PYTHON=

# --- PyTorch GPU runtime (041-R15) ---
# Linux ROCm host: fixed local directory for the MIOpen find-db (not the shared drive), kept for
# the whole run. cuDNN benchmark mode is used on CUDA hosts only.
# MIOPEN_USER_DB_PATH=

# --- Self-match harness, tools/openbw/selfmatch.sh (optional) ---
# Agent server port
# PORT=7600
# Stop each game after this many frames
# URANIUM_MAX_FRAMES=
# 1 = every game uses seed_base (determinism check)
# SAME_SEED=0

# --- .env location (optional) ---
# Read this file instead of <repo>/.env. Set it in the process environment, not in .env.
# URANIUM_ENV_FILE=

# Internal: URANIUM_AGENT_ADDR, URANIUM_GAME_ID, URANIUM_LAN_SLOT, URANIUM_PRIVILEGED and URANIUM_SEED are passed
# by uranium-hostd (and tools/openbw/selfmatch.sh) to each game launcher. Do not set them here.
# Likewise URANIUM_REPLAY_PERSPECTIVE and URANIUM_REPLAY_ENEMY are set by hostd / uranium-replay
# for replay jobs.

# --- uranium-agent debug (optional) ---
# URANIUM_AGENT_DEBUG_VIS=1
# URANIUM_AGENT_DUMP=
# URANIUM_AGENT_DUMP_MAX_FRAME=240

# --- Game host daemon, uranium-hostd (020-R9) ---
# Control listen address (loopback for a single-host setup)
URANIUM_HOSTD_LISTEN=127.0.0.1:7700
# BWAPI (OpenBW fork) build dir containing bin/BWAPILauncher (e.g. <repo>/third_party/bwapi/build)
URANIUM_BWAPI_DIR=
# Bridge AI module (Linux: liburanium_bridge.so, Windows: uranium_bridge.dll)
URANIUM_BRIDGE_LIB=
# Max concurrent games on this host. Leave empty to use the value measured by
# `uranium-env calibrate` (<URANIUM_CACHE_DIR>/hostd_calibration.toml, 020-R10);
# before calibration the default is max(1, (cores - 1) / 2).
# URANIUM_HOSTD_MAX_GAMES=
# Windows only: first TCP port for OpenBW LAN pairs (011-R16)
# URANIUM_HOSTD_PORT_BASE=17000
# Wall-time limit in seconds for one StartReplay job (040 replay streaming, M4)
# URANIUM_HOSTD_REPLAY_TIMEOUT_S=1800
# Folder for game replays of plans with save_replay = true (040 botgen); default: per-game work dir
# URANIUM_HOSTD_REPLAY_DIR=
# OpenBW drops a LAN client that stops syncing after this many ms (patch 0013, 011-R18).
# hostd passes it to every launcher; lockstep training waits on the agent, so the default is
# 600000 (10 min) instead of OpenBW's 60000.
# URANIUM_OPENBW_DROP_TIMEOUT_MS=600000
# Per-game working directories (default: <system temp>/uranium-hostd)
# URANIUM_HOSTD_WORK_DIR=
# T1 bots built by tools/oss/build_<bot>.sh: <dir>/<bot>/{module.so|module.dll, VERSION, bwapi-data/}
# (default for the build scripts: <repo>/build/oss_bots)
# URANIUM_OSS_BOTS_DIR=

# --- Game scheduler, uranium-env (020) ---
# Host list file (not committed; see config/hosts.example.toml). Default: local hostd only.
# URANIUM_HOSTS_FILE=
# Agent server address the bridges connect to (must be reachable from every game host)
# URANIUM_AGENT_LISTEN=127.0.0.1:7600
# Address handed to bridges when it differs from the listen address (e.g. listen on 0.0.0.0)
# URANIUM_AGENT_PUBLIC_ADDR=
# Inference device for `model` players: `python -m uranium run | serve | scr --backend cuda|rocm|cpu`
# (default: this host's GPU).
# Test only (011-AC9 / 031-AC5): with plan `surrender = "on"` the model player surrenders at the
# first decision at or after this frame, whatever the 031-R12 check says.
# URANIUM_TEST_SURRENDER_FRAME=2400

# 031-AC1 OpenBW scenario test (`cargo test -p uranium-env --test openbw_actions -- --ignored`,
# read from the process environment only): hostd control address, and the test's own agent
# listen address. With a hostd on another PC listen on 0.0.0.0 and set URANIUM_AGENT_PUBLIC_ADDR.
# URANIUM_TEST_HOSTD=127.0.0.1:7700
# URANIUM_TEST_AGENT_LISTEN=127.0.0.1:0

# --- features (030 / 031, M5) ---
# Folder of <map_hash>.toml map precomputes written by `uranium-replay build` (031). Required by
# `uranium-replay build` and every BC command (`python -m uranium bc | bc-eval | bc-profile`,
# `uranium-train label-check`); there is no default
# (B-2): BC refuses to start when a selected game's map has no precompute here.
# Live games also read <map file sha256>.resources.toml from it (`uranium-replay mapgen <scx>`, AMB-031-4).
# Note: the same key also names the hostd map folder above, so on a game host both live in one folder.
# URANIUM_MAPS_DIR=

# --- replay dataset build, uranium-replay (040) ---
# Local folder where `uranium-replay build` completes each shard before copying it to the shared
# drive and verifying the copy by SHA-256 (040-R17). Must be a local disk. A shard whose copy fails
# verification stays here. Default: <temp>/uranium-replay/shard-staging.
# URANIUM_SHARD_STAGING_DIR=
# Debug: print the header player -> BWAPI id match and early supply trace while replaying
# URANIUM_REPLAY_DEBUG=1

# --- BC training data (041-R16) ---
# Batches built ahead of the GPU update (~4 GB each at 32 lanes x T64; up to depth + 2 in memory).
# 0 = no data thread, one batch in memory. Does not change the batches. Default 2 (the Linux ROCm
# host too, with URANIUM_MALLOC_MMAP_THRESHOLD below: peak RSS ~6.3 GB, 2026-10-24).
# URANIUM_BC_PREFETCH=2
# 041-R17: entity encoder in chunks of this many rows, recomputed in the backward
# (torch.utils.checkpoint; device memory only, same values). 0 = off (default; the Linux ROCm
# host too since AMB-041-8: worst shape 5.7 GiB GPU, 16 saves memory at ~17% slower updates).
# URANIUM_BC_ENTITY_CHUNK=0
# 041-R18: 1 = keep batches' spatial planes and location masks zstd-compressed until their lane
# group trains (host memory ~4 GB -> ~1 GB per batch). Does not change the batches. Default 0.
# URANIUM_BC_PACK_BATCH=0
# Threads that extract one batch's lanes and unpack a packed lane group's planes. Does not change
# the batches. Unset or 0 = 3 (more take CPU from the trainer, reports/pytorch_opt.md 2.21).
# URANIUM_BC_FEED_THREADS=
# 041-R3 / AMB-041-7: lanes per lane group (0 = all lanes); unset = the config's micro_lanes. Same
# gradients (only the dropout draws are grouped differently), so hosts may differ within a run.
# Decided 2026-10-24: CUDA host 2, Linux ROCm host 1.
# URANIUM_BC_MICRO_LANES=
# Linux (glibc): blocks of at least this many bytes are mapped and returned to the OS when freed,
# so the batches' feature blocks do not stay in the heap (Linux ROCm host: Feeder peak RSS
# 8.2 -> 2.4 GB at 1048576; batch building ~2 s slower, hidden by prefetch). Unset = glibc default.
# URANIUM_MALLOC_MMAP_THRESHOLD=1048576
# 060-R3, Linux (glibc): at most this many malloc arenas. The feed's per-batch threads otherwise
# get their own arenas: a long BC run on the Linux ROCm host grew ~25 MB per update (all in 64 MB
# arena heaps) until it swapped; at 2 the resident size stayed near 6.6 GB (2026-10-25). Host
# memory only, same values. Unset = glibc default.
# URANIUM_MALLOC_ARENA_MAX=2

# --- Implementation switches (AMB-000-4 step 2, 032-R19: same math, the faster one per backend) ---
# Unset = the backend's default (uranium/device.py IMPL_DEFAULTS, measured in reports/pytorch_opt.md);
# set only to override. Values in parentheses: CUDA host default / Linux ROCm host default.
# Location head rows: off / exact / mult8 / pow2 (pow2 / exact)
# URANIUM_LOC_ROWS=
# Location head 1x1 output: conv / mulsum (conv / mulsum)
# URANIUM_LOC_OUT=
# Host -> device copies: sync / pinned (BC training pinned, else sync / sync)
# URANIUM_H2D=
# Distance bias gather and table gradient: embedding / index_add / table_t (embedding / table_t)
# URANIUM_BIAS_GRAD=
# Stem and stride-2 conv weight gradients: vendor / bmm (vendor / bmm)
# URANIUM_CONV_WGRAD=
# Entity attention: torch / fused (hand-written kernel, 060-R1) (fused / fused)
# URANIUM_ENTITY_ATTN=
# Linear weight gradients: vendor / splitk (split-K batched GEMM; f32 only) (vendor / splitk)
# URANIUM_LINEAR_WGRAD=
# Adam / AdamW update: default / foreach / fused / single (default / default)
# URANIUM_ADAM=
# torch.compile of the BC forward: off / default / max-autotune / max-autotune-no-cudagraphs /
# reduce-overhead (BC training reduce-overhead = CUDA graph replay, else default / off; needs
# Triton: Linux CUDA wheels bring it, Windows `uv pip install -e .[compile]`; without it the run
# stays eager with a warning)
# URANIUM_COMPILE=
# Spatial encoder / location head activations and conv weights channels-last: off / on
# (BC training on, else off / off; torch.compile takes several times longer per shape)
# URANIUM_CHANNELS_LAST=
# Spatial planes rounded to bf16 on the host before the copy (bf16 autocast only; same result):
# off / on (BC training on / off)
# URANIUM_SPATIAL_BF16=
# Stem conv input channels zero-padded to a multiple of 8 (same conv): off / on (BC training on / off)
# URANIUM_STEM_PAD=
# Compiled shapes: auto (symbolic after a change) / on (symbolic from the start) / off
# URANIUM_COMPILE_DYNAMIC=
# Compiled dropout draws: eager (default: the uncompiled run's draws, same speed) / inductor (its own generator)
# URANIUM_COMPILE_RNG=
# Inference act from captured CUDA / HIP graphs per input shape: off / on (on / on)
# URANIUM_INFER_GRAPH=
# Largest inference batch replayed from a graph (larger ones run eagerly; every captured shape keeps
# its memory). Unset = no limit (CUDA host); Linux ROCm host default 1 (spec 060-R3 inference budget).
# URANIUM_INFER_GRAPH_MAX_BATCH=
# Inference act through torch.compile (inside the graph): off / default / ... as URANIUM_COMPILE (default / off)
# URANIUM_INFER_COMPILE=
# Inference server stream: shared (default) / own. `own` stalled the Linux ROCm host for minutes
# when an RL learner trained in the same process; do not set it there.
# URANIUM_INFER_STREAM=
# AMB-042-10 profiling: per-batch inference latency parts and learner update spans as JSON lines in
# <prefix>-<checkpoint>.jsonl / <prefix>-learner.jsonl. Unset = off.
# URANIUM_INFER_PROFILE=
# Compiled hand-written kernels; default ~/.cache/uranium/kernels
# URANIUM_KERNEL_DIR=

# --- BC training debug (optional) ---
# 1 = one JSON line per update on stderr with wall time per phase (device synced at every mark)
# URANIUM_BC_PROFILE=1

# --- Tests (optional) ---
# The cross-device tests (032-AC1, AC8) are `pytest -m gpu tests/python` on a CUDA or ROCm host.
# Full-size Burn parity dumps for tests/python (032-AC10), os.pathsep separated:
# URANIUM_PARITY_DIRS=
# Real BC shards for the Rust / Python batch comparison (tests/python/test_core.py):
# URANIUM_TEST_SHARDS=

# --- Windows OpenBW build, tools/openbw/build.ps1 / build_bridge.ps1 (optional) ---
# CMake generator; default "Visual Studio 18 2026" (e.g. "Visual Studio 17 2022" for an older Visual Studio)
# URANIUM_CMAKE_GENERATOR=

# --- SC:R bridge (012), tools/scr/build.ps1 / run.ps1, docs/scr.md ---
# samase64.exe (samase 0.10.28-64; run.ps1 checks its SHA-256)
# URANIUM_SCR_SAMASE=
# samase mod folder the bridge DLL goes into; default <repo>\runs\scr\mod
# URANIUM_SCR_MOD_DIR=
# Agent server of `python -m uranium scr`; default 127.0.0.1:7700
# URANIUM_SCR_AGENT_ADDR=
# Bridge log folder (uranium_bridge_scr.log); run.ps1 default <repo>\runs\scr\logs
# URANIUM_SCR_LOG_DIR=
# Debug: write the GameInfo message (postcard) to this file at game start (static map check)
# URANIUM_SCR_DUMP_GAMEINFO=

# --- SC:R ladder replay collector, uranium-ladder (043) ---
# Local web API port of the logged-in SC:R client; default: detected from StarCraft.exe (043-R3)
# URANIUM_SCR_API_PORT=
# Requests per second, local API and replay downloads combined (043-R4)
# URANIUM_LADDER_RPS=0.5
# Replay downloads per local calendar day (043-R4)
# URANIUM_LADDER_DAILY_MAX=1000
