# Rust
/target/
**/target/

# Third-party build outputs (sources are cloned by tools/openbw/fetch.sh)
/third_party/openbw/
/third_party/bwapi/
/third_party/*/build/

# Game data (copyrighted, never commit) — see spec 011 / config/assets.toml
/sc_data/
*.mpq
*.MPQ
*.scx
*.scm
*.rep

# Training artifacts (spec 060-R4: local only)
/checkpoints/
/datasets/
/runs/
*.mpk

# Large raw reports
/reports/raw/
/bridge/openbw/build/
/runs/

# Host settings and secrets (spec 001-R9/R10): only the template is tracked
.env
.env.*
!.env.example
