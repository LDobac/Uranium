# Rust
/target/
**/target/

# Python (AMB-000-4): virtual environments, caches, the built extension module
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
/python/uranium/_core*.so
/python/uranium/_core*.pyd

# Third-party sources are fetched by tools/openbw/build.sh and tools/oss/build_<bot>.sh
# (pinned commits/archives); only our patches are tracked.
/third_party/*
!/third_party/patches/

# Game data (copyrighted, never commit) — see spec 011 / config/assets.toml
/sc_data/
*.mpq
*.MPQ
*.scx
*.scm
*.rep

# Training artifacts (spec 060-R4: local only)
/checkpoints/
/datasets/
/runs/
*.mpk

# Large raw reports
/reports/raw/
/bridge/openbw/build/
/runs/

# Host settings and secrets (spec 001-R9/R10): only the template is tracked
.env
.env.*
!.env.example
config/hosts.toml
/build/
# 031 map precompute output (derived from map data, not committed)
/assets/maps/

# hipify output of the hand-written kernels (built at first use on ROCm hosts)
python/uranium/kernels/*.hip
python/uranium/kernels/*_hip.*
