new file mode 100644
index 0000000..727bd15
--- /dev/null
+++ b/Source/McRave/Main/linux/compat.h
@@ -0,0 +1,19 @@
+// Uranium patch: GCC/Linux compatibility for MSVC-only constructs (spec 021, T1 stage 2).
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <cstdarg>
+#include <cstdio>
+#include <ctime>
+#include <thread>
+#include <chrono>
+#include <algorithm>
+// MSVC vsnprintf_s comes in 4- and 5-argument forms; map both onto vsnprintf.
+inline int uranium_vsnprintf_s(char* buf, size_t size, const char* fmt, va_list args) { return vsnprintf(buf, size, fmt, args); }
+inline int uranium_vsnprintf_s(char* buf, size_t size, size_t, const char* fmt, va_list args) { return vsnprintf(buf, size, fmt, args); }
+#define vsnprintf_s(buf, size, ...) uranium_vsnprintf_s((buf), (size), __VA_ARGS__)
+#define vsprintf_s(buf, size, fmt, args) vsnprintf((buf), (size), (fmt), (args))
+#define sprintf_s snprintf
+inline int localtime_s(struct tm* out, const time_t* t) { return localtime_r(t, out) ? 0 : 1; }
+// MSVC errno_t (used with localtime_s).
+typedef int errno_t;
