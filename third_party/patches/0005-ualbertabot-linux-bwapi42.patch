diff --git a/UAlbertaBot/Source/linux/UraniumModule.cpp b/UAlbertaBot/Source/linux/UraniumModule.cpp
new file mode 100644
index 0000000..f79dc24
--- /dev/null
+++ b/UAlbertaBot/Source/linux/UraniumModule.cpp
@@ -0,0 +1,40 @@
+// Uranium patch: expose UAlbertaBot (BWAPI 4.4 client-mode bot) as a BWAPI 4.2 AI module
+// so OpenBW's BWAPILauncher can load it as a T1 opponent (spec 021, stage 1).
+#include <BWAPI.h>
+
+#include "../UAlbertaBotModule.h"
+#include "../../../SparCraft/source/SparCraft.h"
+#include "../../../BOSS/source/BOSS.h"
+
+namespace {
+
+class UABModule : public BWAPI::AIModule {
+  UAlbertaBot::UAlbertaBotModule bot;
+
+ public:
+  void onStart() override { bot.onStart(); }
+  void onFrame() override { bot.onFrame(); }
+  void onEnd(bool isWinner) override { bot.onEnd(isWinner); }
+  void onUnitDestroy(BWAPI::Unit u) override { bot.onUnitDestroy(u); }
+  void onUnitMorph(BWAPI::Unit u) override { bot.onUnitMorph(u); }
+  void onSendText(std::string t) override { bot.onSendText(t); }
+  void onUnitCreate(BWAPI::Unit u) override { bot.onUnitCreate(u); }
+  void onUnitComplete(BWAPI::Unit u) override { bot.onUnitComplete(u); }
+  void onUnitShow(BWAPI::Unit u) override { bot.onUnitShow(u); }
+  void onUnitHide(BWAPI::Unit u) override { bot.onUnitHide(u); }
+  void onUnitRenegade(BWAPI::Unit u) override { bot.onUnitRenegade(u); }
+};
+
+}  // namespace
+
+extern "C" __attribute__((visibility("default"))) void gameInit(BWAPI::Game* game) { BWAPI::BroodwarPtr = game; }
+extern "C" __attribute__((visibility("default"))) BWAPI::AIModule* newAIModule() {
+  // main.cpp of the client-mode bot initializes these before connecting.
+  static bool initialized = false;
+  if (!initialized) {
+    SparCraft::init();
+    BOSS::init();
+    initialized = true;
+  }
+  return new UABModule();
+}
diff --git a/UAlbertaBot/Source/linux/compat.h b/UAlbertaBot/Source/linux/compat.h
new file mode 100644
index 0000000..b8b805d
--- /dev/null
+++ b/UAlbertaBot/Source/linux/compat.h
@@ -0,0 +1,17 @@
+// Uranium patch: GCC/Linux compatibility for MSVC-only constructs (spec 021, T1 stage 1).
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <cstdarg>
+#include <cstdio>
+#include <ctime>
+#include <thread>
+#include <chrono>
+#include <algorithm>
+// MSVC vsnprintf_s comes in 4- and 5-argument forms; map both onto vsnprintf.
+inline int uranium_vsnprintf_s(char* buf, size_t size, const char* fmt, va_list args) { return vsnprintf(buf, size, fmt, args); }
+inline int uranium_vsnprintf_s(char* buf, size_t size, size_t, const char* fmt, va_list args) { return vsnprintf(buf, size, fmt, args); }
+#define vsnprintf_s(buf, size, ...) uranium_vsnprintf_s((buf), (size), __VA_ARGS__)
+#define vsprintf_s(buf, size, fmt, args) vsnprintf((buf), (size), (fmt), (args))
+#define sprintf_s snprintf
+inline int localtime_s(struct tm* out, const time_t* t) { return localtime_r(t, out) ? 0 : 1; }
