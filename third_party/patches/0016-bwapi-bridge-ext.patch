diff --git a/bwapi/Shared/UraniumBridgeExt.h b/bwapi/Shared/UraniumBridgeExt.h
new file mode 100644
index 00000000..46f7761f
--- /dev/null
+++ b/bwapi/Shared/UraniumBridgeExt.h
@@ -0,0 +1,36 @@
+#pragma once
+// Uranium patch 0016 (spec 011-R23): extensions for the Uranium bridge. They act only in a process
+// started with URANIUM_BRIDGE_EXT=1 (hostd sets it for the bridge's launcher alone, 020-R17);
+// otherwise BWAPI behaves as the original, which matters because OSS bots run on this same build.
+#include <cstdlib>
+#include <cstring>
+
+#include <BWAPI/UnitCommand.h>
+#include <BWAPI/UnitCommandType.h>
+#include <BWAPI/UnitType.h>
+
+namespace BWAPI
+{
+  namespace UraniumExt
+  {
+    inline bool enabled()
+    {
+      static const bool on = [] {
+        const char* v = std::getenv("URANIUM_BRIDGE_EXT");
+        return v != nullptr && std::strcmp(v, "1") == 0;
+      }();
+      return on;
+    }
+    // 011-R23 (2): a ghost command is Attack_Unit or Right_Click_Unit without a target unit: x, y
+    // are the position, extra = (unit type << 1) | queued. It goes to the game as a TargetedOrder
+    // MoveToAttack (Attack2) or a RightClick action that carries the unit type and no unit, as when
+    // a player clicks a building's ghost in the fog. Without the extension BWAPI rejects it (no target).
+    inline bool isGhost(const UnitCommand& c)
+    {
+      return enabled() && c.target == nullptr &&
+             (c.type == UnitCommandTypes::Attack_Unit || c.type == UnitCommandTypes::Right_Click_Unit);
+    }
+    inline UnitType ghostUnitType(const UnitCommand& c) { return UnitType(c.extra >> 1); }
+    inline bool ghostQueued(const UnitCommand& c) { return (c.extra & 1) != 0; }
+  }
+}
